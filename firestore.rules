rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CAMBIA este correo por tu correo de administrador (el mismo de CONFIG.adminEmail)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'tu-correo@gmail.com';
    }
    function signedIn() {
      return request.auth != null;
    }

    // Precios (trade in, AppleCare, Onsafe, bancos): todos leen, solo el admin escribe
    match /config/precios {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Productos creados: todos leen y crean, solo el admin edita o borra
    match /productos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['n', 'p', 'cat', 'por', 'f'])
        && request.resource.data.n is string
        && request.resource.data.n.size() > 0
        && request.resource.data.n.size() < 80
        && request.resource.data.p is int
        && request.resource.data.p >= 0
        && request.resource.data.p < 100000000
        && request.resource.data.cat in ['iPhone', 'iPad', 'Mac', 'Watch', 'Audio', 'TV', 'Accesorio'];
      allow update, delete: if isAdmin();
    }
  }
}
